# Copy to .env (never commit .env). Placeholder values only.
NODE_ENV=development
PORT=4000
# Storage: mongo (default) or memory. memory keeps data in the process only (tests, local Postman runs)
# and is refused when NODE_ENV=production.
STORAGE=mongo
# MongoDB Atlas connection string for the least-privilege app user. Required when STORAGE=mongo.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=nutritale
# Signing secret for access tokens (HS256). At least 32 characters. Generate your own, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<replace-with-at-least-32-random-characters>
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Global limit: requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Tighter limit shared by /auth/register, /auth/login and /auth/refresh, per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Public catalogue routes, per IP.
CATALOGUE_RATE_LIMIT_WINDOW_MS=60000
CATALOGUE_RATE_LIMIT_MAX=60
# Largest JSON body accepted.
JSON_BODY_LIMIT=100kb
