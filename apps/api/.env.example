# Copy to .env (never commit .env). Placeholder values only.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string for the least-privilege app user. Not used yet: the skeleton does not connect.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=nutritale
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Largest JSON body accepted.
JSON_BODY_LIMIT=100kb
