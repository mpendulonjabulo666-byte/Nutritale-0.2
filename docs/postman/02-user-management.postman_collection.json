    {
      "name": "Global rate limit on /me -> 429 (repeats until limited)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{b_accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('first call answers 200 or 429', function () { pm.expect([200, 429]).to.include(pm.response.code); });",
              "const header = [{ key: 'Content-Type', value: 'application/json' }];",
              "header.push({ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('b_accessToken') });",
              "const max = 1000;",
              "let tries = 0;",
              "function fire() {",
              "  tries += 1;",
              "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/me', method: 'GET', header, body: { mode: 'raw', raw: '' } }, function (err, res) {",
              "    if (!err && res.code === 429) {",
              "      pm.test('rate limit reached: 429 after ' + tries + ' extra requests', function () { pm.expect(res.code).to.eql(429); });",
              "      pm.test('429 uses the JSON error shape', function () { pm.expect(res.json()).to.eql({ error: { code: 'rate_limited', message: 'Too many requests, try again later' } }); });",
              "      return;",
              "    }",
              "    if (tries >= max) { pm.test('rate limit reached within ' + max + ' requests', function () { pm.expect.fail('no 429'); }); return; }",
              "    fire();",
              "  });",
              "}",
              "fire();"
            ]
          }
        }
      ]
    }
  ]
