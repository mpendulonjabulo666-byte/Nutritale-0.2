    {
      "name": "Auth rate limit -> 429 (repeats login until limited)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"limit@example.test\",\n  \"password\": \"wrong-password-1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('first call answers 401 or 429', function () { pm.expect([401, 429]).to.include(pm.response.code); });",
              "const header = [{ key: 'Content-Type', value: 'application/json' }];",
              "",
              "const max = 100;",
              "let tries = 0;",
              "function fire() {",
              "  tries += 1;",
              "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/auth/login', method: 'POST', header, body: { mode: 'raw', raw: JSON.stringify({ email: 'limit@example.test', password: 'wrong-password-1' }) } }, function (err, res) {",
              "    if (!err && res.code === 429) {",
              "      pm.test('rate limit reached: 429 after ' + tries + ' extra requests', function () { pm.expect(res.code).to.eql(429); });",
              "      pm.test('429 uses the JSON error shape', function () { pm.expect(res.json()).to.eql({ error: { code: 'rate_limited', message: 'Too many requests, try again later' } }); });",
              "      return;",
              "    }",
              "    if (tries >= max) { pm.test('rate limit reached within ' + max + ' requests', function () { pm.expect.fail('no 429'); }); return; }",
              "    fire();",
              "  });",
              "}",
              "fire();"
            ]
          }
        }
      ]
    }
  ]
