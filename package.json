{
  "name": "nutritale",
  "version": "0.0.0",
  "private": true,
  "description": "NutriTale V1 monorepo: Expo mobile app, Next.js web app, Express API and shared design tokens.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
